#!/bin/bash

# 配置路径
CONFIG_DIR="$HOME/.claude"
CONFIG_FILE="$CONFIG_DIR/settings.json"

# 颜色定义
ORANGE='\033[38;5;208m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
GRAY='\033[0;90m'
NC='\033[0m'

show_welcome() {
    # 计算边框宽度 79
    BORDER_LINE=$(printf '═%.0s' {1..77})
    SPACE_LINE=$(printf ' %.0s' {1..77})

    echo -e ""
    echo -e "${ORANGE}╔${BORDER_LINE}╗${NC}"
    echo -e "${ORANGE}║${SPACE_LINE}║${NC}"
    echo -e "${ORANGE}║${SPACE_LINE}║${NC}"
    echo -e "${ORANGE}║${NC}  ${ORANGE}    ▐▛███▜▌${NC}      ${CYAN}密钥设置-设置 Claude Code 认证程序 V1.0.2 ${NC}                ${ORANGE}║${NC}"
    echo -e "${ORANGE}║${NC}  ${ORANGE}   ▝▜█████▛▘${NC}    ${CYAN}你需要提前安装上 git、nodejs >= v22、Claude${NC}                ${ORANGE}║${NC}"
    echo -e "${ORANGE}║${NC}  ${ORANGE}     ▘▘ ▝▝${NC}    ${CYAN}如果已安装，在项目文件夹下命令行执行 claude 进行开发        ${NC} ${ORANGE}║${NC}"
    echo -e "${ORANGE}║${SPACE_LINE}║${NC}"
    echo -e "${ORANGE}╚${BORDER_LINE}╝${NC}"
    echo -e ""
}

check_env() {
    NODE_OK=true
    GIT_OK=true
    CLAUDE_OK=true

    if command -v node >/dev/null 2>&1; then
        echo -e "${GREEN}[√] Node.js 已安装: $(node -v)${NC}"
    else
        echo -e "${RED}[X] 未检测到 Node.js${NC}"
        NODE_OK=false
    fi

    if command -v git >/dev/null 2>&1; then
        echo -e "${GREEN}[√] Git 已安装: $(git --version)${NC}"
    else
        echo -e "${RED}[X] 未检测到 Git${NC}"
        GIT_OK=false
    fi

    if command -v claude >/dev/null 2>&1; then
        echo -e "${GREEN}[√] Claude Code 已安装 : $(claude --version 2>&1 | head -n 1)${NC}"
    else
        echo -e "${RED}[X] 未检测到 Claude Code${NC}"
        CLAUDE_OK=false
    fi

    [[ "$NODE_OK" = true && "$GIT_OK" = true && "$CLAUDE_OK" = true ]] && return 0 || return 1
}

restore_config() {
    if [ -f "$CONFIG_FILE" ]; then
        TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
        BACKUP_FILE="$CONFIG_FILE.bak_$TIMESTAMP"
        mv "$CONFIG_FILE" "$BACKUP_FILE"
        echo -e "${GREEN}原配置已备份为: $(basename "$BACKUP_FILE")${NC}"
        echo -e "${YELLOW}配置文件已重置。${NC}"
    else
        echo -e "${GRAY}未发现配置文件，无需恢复。${NC}"
    fi
}

set_claude_token() {
    # 强制从 TTY 读取输入
    echo -n "请输入您的 ID: "
    read ID < /dev/tty
    if [ -z "$ID" ]; then echo -e "${YELLOW}取消操作${NC}"; return; fi
    ID=$(echo $ID | xargs)

    echo -n "请输入您的 TOKEN: "
    read TOKEN < /dev/tty
    if [ -z "$TOKEN" ]; then echo -e "${YELLOW}取消操作${NC}"; return; fi

    mkdir -p "$CONFIG_DIR"
    BASE_URL="http://dat6.com:18000/$ID"
    restore_config

    cat <<EOF > "$CONFIG_FILE"
{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "$TOKEN",
    "ANTHROPIC_BASE_URL": "$BASE_URL",
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  }
}
EOF
    echo -e "${GREEN}配置已更新!${NC}"
    echo -e "${CYAN}BASE_URL: $BASE_URL${NC}"
}

show_menu() {
    while true; do
        echo -e "\n----------- 菜单 -----------"
        echo "1. 设置 Token 并写入配置"
        echo "2. 恢复配置 (备份并移除当前配置)"
        echo "3. 启动 Claude Code"
        echo "4. 退出"
        echo -n "请选择 (1-4): "
        
        # 强制从终端获取输入，如果 read 失败(EOF)则直接退出脚本防止死循环
        if ! read CHOICE < /dev/tty; then
            echo -e "${RED}读取输入失败，正在退出...${NC}"
            exit 1
        fi

        case $CHOICE in
            1) set_claude_token ;;
            2) restore_config ;;
            3) echo -e "${GREEN}启动中...${NC}"; claude ;;
            4) exit 0 ;;
            *) echo -e "${RED}无效选择: $CHOICE${NC}" ;;
        esac
    done
}

# 执行
clear
show_welcome
if check_env; then
    show_menu
else
    echo -e "\n${YELLOW}环境不完善，请安装缺失组件。${NC}"
    exit 1
fi